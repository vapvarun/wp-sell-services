{
 "$schema": "https://wpmediaverse.com/schemas/wp-plugin-qa-config-v1.json",
 "slug": "wp-sell-services",
 "name": "WP Sell Services",
 "version_constant": "WPSS_VERSION",
 "main_file": "wp-sell-services.php",
 "autologin_param": "autologin",
 "rest_namespace": "wpss/v1",
 "front_routes": [
  "/",
  "/dashboard/",
  "/dashboard/orders/",
  "/become-a-vendor/",
  "/service-cart/",
  "/buyer-request/",
  "/vendors/"
 ],
 "pair": {
  "pro_slug": "wp-sell-services-pro",
  "pro_version_constant": "WPSS_PRO_VERSION",
  "pro_main_file": "wp-sell-services-pro.php",
  "lockstep": true
 },
 "basecamp": {
  "project_id": 45156734,
  "bugs_column_id": 9381846253,
  "ready_for_testing_column_id": 9381846126
 },
 "modes": [
  "free",
  "combo"
 ],
 "report_path": ".qa-results/last-smoke-pass.json",
 "supplements_path": null,
 "journeys_path": "audit/journeys",
 "testing_guideline": "docs/qa/TESTING-GUIDELINE.md",
 "rail_note": "The checkout rail is a run parameter (--rail woo|edd|fluentcart|standalone), not a site setting to flip by hand. A guard that needs a rail sets it itself and restores it.",
 "debug_log_whitelist": [
  "woo-order-test",
  "woocommerce-gateway-dummy",
  "jquery-migrate",
  "Refused a partial refund"
 ],
 "personas": [
  {
   "key": "visitor",
   "login": null,
   "role": "(logged out)",
   "email": null,
   "note": "Public catalog, single service, vendor directory, buyer requests."
  },
  {
   "key": "buyer",
   "login": "wpss_buyer_ella",
   "role": "subscriber",
   "email": "wpss_buyer_ella@example.test",
   "note": "Holds NO wpss_* capability. Every buyer gate is an ownership check, never a cap check."
  },
  {
   "key": "buyer_2",
   "login": "wpss_buyer_ben",
   "role": "subscriber",
   "email": "wpss_buyer_ben@example.test",
   "note": "Second buyer, same role. Proves one buyer cannot reach another's order, dispute or request."
  },
  {
   "key": "vendor",
   "login": "wpss_vendor_maya",
   "role": "wpss_vendor",
   "email": "wpss_vendor_maya@example.test",
   "note": "Vendor is ADDITIVE - still a buyer. Dashboard must be role-aware, not role-switched."
  },
  {
   "key": "vendor_2",
   "login": "wpss_vendor_sofia",
   "role": "wpss_vendor",
   "email": "wpss_vendor_sofia@example.test",
   "note": "Second vendor, same role. Required for cross-vendor permission checks."
  },
  {
   "key": "admin",
   "login": "wpss_qa_admin",
   "role": "administrator",
   "email": null,
   "note": "Control rung. Test LAST and never alone - admin passes hide participant-check bugs."
  }
 ],
 "checks": {
  "static": [
   {
    "id": "account-standing",
    "run": "${WP_CLI:-wp} eval-file tests/test-account-standing.php"
   },
   {
    "id": "audit-log-coverage",
    "run": "${WP_CLI:-wp} eval-file tests/test-audit-log-coverage.php"
   },
   {
    "id": "audit-log-object-filter",
    "run": "${WP_CLI:-wp} eval-file tests/test-audit-log-object-filter.php"
   },
   {
    "id": "auto-withdrawal-schedule",
    "run": "${WP_CLI:-wp} eval-file tests/test-auto-withdrawal-schedule.php"
   },
   {
    "id": "check-skeleton",
    "run": "php bin/check-skeleton.php"
   },
   {
    "id": "check-time-formatter",
    "run": "php bin/check-time-formatter.php"
   },
   {
    "id": "check-ux-conformance",
    "run": "php bin/check-ux-conformance.php"
   },
   {
    "id": "dark-mode-and-icon-hooks",
    "run": "${WP_CLI:-wp} eval-file tests/test-dark-mode-and-icon-hooks.php"
   },
   {
    "id": "docs-audit",
    "run": "python3 bin/docs-audit.py"
   },
   {
    "id": "focus-indicator-css",
    "run": "${WP_CLI:-wp} eval-file tests/test-focus-indicator-css.php"
   },
   {
    "id": "form-state-and-feedback",
    "run": "${WP_CLI:-wp} eval-file tests/test-form-state-and-feedback.php"
   },
   {
    "id": "integration-seam-contract",
    "run": "${WP_CLI:-wp} eval-file tests/test-integration-seam-contract.php"
   },
   {
    "id": "layout-surface-css",
    "run": "${WP_CLI:-wp} eval-file tests/test-layout-surface-css.php"
   },
   {
    "id": "multi-checkout-tax-label",
    "run": "${WP_CLI:-wp} eval-file tests/test-multi-checkout-tax-label.php"
   },
   {
    "id": "no-defaults-on-update-routes",
    "run": "${WP_CLI:-wp} eval-file tests/test-no-defaults-on-update-routes.php"
   },
   {
    "id": "notification-center-retention",
    "run": "${WP_CLI:-wp} eval-file tests/test-notification-center-retention.php"
