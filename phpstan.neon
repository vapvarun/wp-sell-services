includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src/
    excludePaths:
        analyseAndScan:
            - vendor/ (?)
            - node_modules/ (?)
            - includes/ (?)
            - tests/ (?)
            - src/SEO/ (?)
    bootstrapFiles:
        - phpstan-bootstrap.php
        - vendor/autoload.php
    scanFiles:
        - src/functions.php
        - tests/stubs/action-scheduler-stubs.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # These four are DEFENSIVE patterns: they cover error shapes that may or
        # may not occur depending on the analysed tree, so `reportUnmatched:
        # false` is correct for them. It is deliberately NOT set globally -
        # `reportUnmatchedIgnoredErrors: true` above must keep reporting stale
        # *baseline* entries, which is the whole point of enabling it.
        # WordPress dynamic hook parameter counts
        -
            message: '#Function apply_filters invoked with#'
            reportUnmatched: false
        -
            message: '#Function do_action invoked with#'
            reportUnmatched: false
        # Template variables passed via extract() (templates/ is not in `paths`,
        # so this only fires if analysis is ever widened to include them)
        -
            message: '#Variable \$\w+ might not be defined#'
            reportUnmatched: false
        # WP functions returning mixed types
        -
            message: '#Cannot access offset .* on mixed#'
            reportUnmatched: false
        # WP_CLI::add_command() registers a command as its side effect; its
        # return value is intentionally unused (phpstan-wordpress cannot model
        # the registration side effect).
        - '#Call to WP_CLI::add_command\(\) on a separate line has no effect#'
        # Build artifacts not present in CI (assets/ not built)
        -
            message: '#Path in include\(\).*\.asset\.php.*is not a file#'
            reportUnmatched: false
