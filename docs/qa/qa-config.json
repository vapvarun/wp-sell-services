{
  "$schema": "https://wpmediaverse.com/schemas/wp-plugin-qa-config-v1.json",
  "slug": "wp-sell-services",
  "name": "WP Sell Services",
  "version_constant": "WPSS_VERSION",
  "main_file": "wp-sell-services.php",
  "base_url": "http://wp-sell-services.local",
  "wp_path": "/Users/vapvarun/Local Sites/wp-sell-services/app/public",
  "autologin_param": "autologin",
  "rest_namespace": "wpss/v1",
  "front_routes": [
    "/",
    "/dashboard/",
    "/dashboard/orders/",
    "/become-a-vendor/",
    "/service-cart/",
    "/buyer-request/",
