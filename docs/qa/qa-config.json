   {
    "id": "notification-read-at",
    "run": "${WP_CLI:-wp} eval-file tests/test-notification-read-at.php"
   },
   {
    "id": "order-product-columns",
    "run": "${WP_CLI:-wp} eval-file tests/test-order-product-columns.php"
   },
   {
    "id": "portfolio-rest-service",
    "run": "${WP_CLI:-wp} eval-file tests/test-portfolio-rest-service.php"
