    "run": "${WP_CLI:-wp} eval-file ../wp-sell-services-pro/tests/test-rest-partial-update.php"
   },
   {
    "id": "pro-seams-subscriptions-carrier",
    "run": "${WP_CLI:-wp} eval-file ../wp-sell-services-pro/tests/test-seams-subscriptions-carrier.php"
   },
   {
    "id": "pro-woo-cart-session-price",
    "run": "${WP_CLI:-wp} eval-file ../wp-sell-services-pro/tests/test-woo-cart-session-price.php"
   },
   {
    "id": "rest-matrix",
    "run": "${WP_CLI:-wp} eval-file tests/test-integration-seam-contract.php  and tests/test-rest-matrix.php"
   },
   {
    "id": "review-status-rest",
    "run": "${WP_CLI:-wp} eval-file tests/test-review-status-rest.php"
   },
   {
    "id": "service-moderation-admin-publish",
